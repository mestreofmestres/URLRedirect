<?xml version="1.0" encoding="utf-8"?>

<configuration>

  <system.webServer>

    <rewrite>

      <rules>

        <!-- GitHub -->
        <rule name="Redirect GitHub" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}"
                 pattern="^github\.mikefreitas\.net$"
                 ignoreCase="true" />
          </conditions>
          <action type="Redirect"
                  url="https://github.com/{R:1}"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>



      </rules>

    </rewrite>

  </system.webServer>

</configuration>